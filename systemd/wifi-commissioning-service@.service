[Unit]
Description=WiFi Commissioning Service (BLE GATT + Unix Socket) - %i
Requires=wpa_supplicant@%i.service bluetooth.service bluetooth.target wifi-commissioning-service@%i.socket
After=wpa_supplicant@%i.service bluetooth.service bluetooth.target wifi-commissioning-service@%i.socket

[Service]
Type=notify
Restart=on-failure
RestartSec=5

User=wifi_commissioning
Group=wifi_commissioning

ExecStart=/bin/bash -c '/usr/bin/wifi-commissioning-service -i %i -s $(/usr/bin/omnect_get_deviceid.sh) --enable-unix-socket'

[Install]
WantedBy=multi-user.target
