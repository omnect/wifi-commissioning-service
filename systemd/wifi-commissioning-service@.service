[Unit]
Description=WiFi Commissioning Service (BLE GATT + Unix Socket) for %I
Requires=wifi-commissioning-service@%i.socket wpa_supplicant@%i.service
After=wifi-commissioning-service@%i.socket wpa_supplicant@%i.service
# bluetooth dependency kept on separate lines for conditional removal by recipe
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=notify
Restart=on-failure
RestartSec=5

User=wifi_commissioning
Group=wifi_commissioning
SupplementaryGroups=wpa_supplicant

EnvironmentFile=-/etc/omnect/wifi-commissioning-service.env
ExecStartPre=/bin/sh -c 'echo DEVICE_ID=$$(/usr/bin/omnect_get_deviceid.sh) > /run/wifi-commissioning-service/%i/device_id.env'
EnvironmentFile=/run/wifi-commissioning-service/%i/device_id.env
ExecStart=/usr/bin/wifi-commissioning-service -i %I -s ${DEVICE_ID}

[Install]
WantedBy=multi-user.target
