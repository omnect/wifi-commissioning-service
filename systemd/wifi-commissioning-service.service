[Unit]
Description=WiFi Commissioning Service (BLE GATT + Unix Socket)
Requires=bluetooth.service bluetooth.target wifi-commissioning-service.socket
After=bluetooth.service bluetooth.target wifi-commissioning-service.socket

[Service]
Type=notify
Restart=on-failure
RestartSec=5

User=wifi_commissioning
Group=wifi_commissioning

EnvironmentFile=-/etc/omnect/wifi-commissioning-service.env
ExecStart=/bin/bash -c '/usr/bin/wifi-commissioning-service $${WIFI_INTERFACE:+-i $${WIFI_INTERFACE}} -s $$(/usr/bin/omnect_get_deviceid.sh)'

[Install]
WantedBy=multi-user.target
