[Unit]
Description=WiFi Commissioning Service (BLE GATT + Unix Socket)
Requires=bluetooth.service bluetooth.target wifi-commissioning-service.socket
After=bluetooth.service bluetooth.target wifi-commissioning-service.socket

[Service]
Type=notify
Restart=on-failure
RestartSec=5

User=wifi_commissioning
Group=wifi_commissioning

EnvironmentFile=-/etc/default/wifi-commissioning
ExecStart=/bin/bash -c '/usr/bin/wifi-commissioning-service -i ${WIFI_INTERFACE} -s $(/usr/bin/omnect_get_deviceid.sh) --enable-unix-socket'

[Install]
WantedBy=multi-user.target
